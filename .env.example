INTERNAL_API_KEY=your_internal_api_key_here

# JWT signing secret (already required for dashboard + mobile login)
JWT_SECRET=your_jwt_secret_here

# ── Mobile OTP login ────────────────────────────────────────────────
# Minutes a generated code stays valid
OTP_TTL_MINUTES=5
# DEV/TEST ONLY: fixed code accepted for DEV_OTP_PHONE only (no message sent).
# Every other number must exist in the users table and receives a real OTP.
DEV_OTP_CODE=
DEV_OTP_PHONE=81220422

# WhatsApp Cloud API (primary OTP channel). If unset, falls back to SMS, then dev log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved authentication template name; if unset a plain text message is sent.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_LANG=en_US

# Twilio SMS (fallback OTP channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000
